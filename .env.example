NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Standard PostgreSQL connection used only by the server-side crawler.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
# Vercel sends CRON_SECRET as the Authorization bearer token for cron requests.
CRON_SECRET="replace-with-a-long-random-value"
# Optional fallback for existing manual cron callers.
CRON_AUTH_KEY=""
REVIEW_AUTH_KEY="replace-with-a-different-long-random-value"
# Dedicated key for the external Multica crawler worker API.
CRAWLER_WORKER_KEY="replace-with-another-long-random-value"
CRAWL_BATCH_SIZE="5"
CRAWL_CONCURRENCY="2"
CRAWL_REQUEST_TIMEOUT_MS="7000"

# Optional LLM enrichment. Disabled unless explicitly enabled.
CRAWLER_LLM_ENABLED="false"
CRAWLER_LLM_API_KEY=""
CRAWLER_LLM_BASE_URL="https://api.groq.com/openai/v1"
CRAWLER_LLM_MODEL="llama-3.3-70b-versatile"
CRAWLER_LLM_TIMEOUT_MS="8000"
# Stop LLM work early so the candidate can still be persisted before the batch deadline.
CRAWLER_LLM_WRITE_RESERVE_MS="3000"
CRAWLER_LLM_MAX_INPUT_CHARS="12000"

# External worker runtime settings (configure these in Multica Runtime, not Vercel).
GETAITOOLS_SITE_URL="https://your-production-domain.example"
GETAITOOLS_CRAWLER_WORKER_KEY=""
CRAWLER_WORKER_BATCH_SIZE="5"
CRAWLER_WORKER_JOB_TIMEOUT_MS="90000"

# Optional. Authenticated requests have a higher GitHub API rate limit.
GITHUB_TOKEN=""
DISCOVERY_GITHUB_TOPICS="ai,llm,generative-ai"

SUBMIT_AUTH_KEY="replace-with-a-long-random-value"
GOOGLE_TRACKING_ID=""
GOOGLE_ADSENSE_URL=""
CONTACT_US_EMAIL="contact@getaitools.app"
