NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# Vercel sends CRON_SECRET as the Authorization bearer token for cron requests.
CRON_SECRET="replace-with-a-long-random-value"
# Optional fallback for existing manual cron callers.
CRON_AUTH_KEY=""
REVIEW_AUTH_KEY="replace-with-a-different-long-random-value"
CRAWL_BATCH_SIZE="5"
CRAWL_CONCURRENCY="2"
CRAWL_REQUEST_TIMEOUT_MS="7000"

# Optional. Authenticated requests have a higher GitHub API rate limit.
GITHUB_TOKEN=""
DISCOVERY_GITHUB_TOPICS="ai,llm,generative-ai"

SUBMIT_AUTH_KEY="replace-with-a-long-random-value"
GOOGLE_TRACKING_ID=""
GOOGLE_ADSENSE_URL=""
CONTACT_US_EMAIL="contact@getaitools.app"
